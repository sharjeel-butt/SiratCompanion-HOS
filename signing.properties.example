# ============================================================
# Signing Credentials — TEMPLATE
# ============================================================
#
# 1. Copy this file:   cp signing.properties.example signing.properties
# 2. Fill in real values below.
# 3. Before building, export them as env vars:
#       Bash / macOS:   set -a; . ./signing.properties; set +a
#       PowerShell:     Get-Content ./signing.properties | ForEach-Object {
#                         if ($_ -match '^([^#].*?)=(.*)$') {
#                           [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim(), 'Process')
#                         }
#                       }
#
# build-profile.json5 reads these via ${VAR}.
#
# NEVER commit signing.properties, and NEVER commit the .p12/.p7b/.cer
# files themselves — they must live OUTSIDE the git repo.
# ============================================================

# ---- Debug (auto-generated by DevEco Studio on first build) ----
DEBUG_STORE_FILE=C:/Users/you/.ohos/config/debug_SiratCompanion_XXXXXX.p12
DEBUG_STORE_PASSWORD=
DEBUG_KEY_ALIAS=debugKey
DEBUG_KEY_PASSWORD=
DEBUG_PROFILE_PATH=C:/Users/you/.ohos/config/debug_SiratCompanion_XXXXXX.p7b
DEBUG_CERT_PATH=C:/Users/you/.ohos/config/debug_SiratCompanion_XXXXXX.cer

# ---- Release (REGENERATE — current key is compromised) ----
RELEASE_STORE_FILE=D:/secrets/siratcompanion/release.p12
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=release_siratcompanionreleasep12
RELEASE_KEY_PASSWORD=
RELEASE_PROFILE_PATH=D:/secrets/siratcompanion/release.p7b
RELEASE_CERT_PATH=D:/secrets/siratcompanion/release.cer